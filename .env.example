# ---------- Supabase (shared with pbj-fitness-app) ----------
# Same Supabase project as the fitness app — we write to the same DB.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsIn...
# Service-role key: marketing site writes on users' behalf (apply form, agreement signing, peptalk bookings).
# NEVER expose this to the browser. NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn...

# ---------- Stripe ----------
# Used to look up checkout sessions on the /onboarding/agreement landing.
STRIPE_SECRET_KEY=sk_test_...

# ---------- Onboarding cookie signing ----------
# Signs the short-lived cookie that tracks a client through the post-payment
# agreement flow. Generate once with:  openssl rand -hex 32
ONBOARDING_COOKIE_SECRET=

# ---------- Handoff URLs ----------
# The fitness app — where clients log in after /apply (magic link) and
# where they land after signing the agreement for the in-app questionnaire.
NEXT_PUBLIC_APP_URL=https://app.protocolsbyjames.com

# Used when sending transactional emails (Resend already wired for contact form).
RESEND_API_KEY=
